# savant-audio-proxy settings.
# On the Savant audio server: /data/RPM/savant-audio-proxy/config.env
# After a change: run the installer again (it keeps this file), or
#   sudo systemctl restart savant-audio-proxy   if only the station list changed.

# ---------------------------------------------------------------- radios
# Name of the radios tile on the Savant music home.
RADIOS_TITLE="My Radios"

# Image of the radios tile (http(s) URL). Empty = logo of the first station.
RADIOS_ICON=""

# Station list: M3U file in this folder, or http(s) URL (reloaded every 10 min).
# Empty = radios disabled.
STATIONS="stations.m3u"

# Now playing (artist, title, cover art) for the radios:
#  - ICY_METADATA="yes": read straight from the station's stream (ICY metadata, sent by most
#    Icecast/Shoutcast stations, Radio Paradise included). While playing, the stream is
#    downloaded a second time to read it; this stops by itself 2 min after playback ends.
#    "no" = Savant shows only the station name and logo.
#  - COVER_URL: your own metadata server (replaces ICY when set):
#      GET <COVER_URL>/<mount>.json  and SSE stream <COVER_URL>/<mount>/events
#      (<mount> = last path element of the stream URL; JSON: title, artist, cover, ...)
ICY_METADATA="yes"
COVER_URL=""

# ---------------------------------------------------------------- Music Assistant (optional)
# Empty = disabled. Easiest: run the installer again with --with-ma.
#   MA_ADDR   : Music Assistant host:port (e.g. 192.168.1.10:8095)
#   MA_PLAYER : player_id of THIS Savant audio server's AirPlay player in Music Assistant
#   The long-lived token is in the "ma_token" file in this folder.
MA_ADDR=""
MA_PLAYER=""
# Image of the "Music Assistant" tile (http(s) URL). Empty = Music Assistant logo, "none" = no image.
MA_ICON=""

# ---------------------------------------------------------------- Roon (optional)
# Empty = disabled. Easiest: run the installer again with --with-roon.
#   ROON_ADDR : Roon Server host[:port] (e.g. 192.168.1.20; port 9330 by default)
#   ROON_ZONE : name of THIS Savant audio server's AirPlay zone (or output) in Roon
#               (Roon > Settings > Audio; enable the AirPlay device there first)
#   The first time, enable "Savant audio proxy" in Roon > Settings > Extensions; its token
#   is then kept in the "roon_token" file in this folder.
ROON_ADDR=""
ROON_ZONE=""
# Image of the "Roon" tile (http(s) URL). Empty = Roon logo, "none" = no image.
ROON_ICON=""

# ---------------------------------------------------------------- misc
# Logos (tile images and station logos): "yes" = downloaded once into the "logos" folder here
# and served by this Savant audio server on LOGOS_PORT (the Savant app no longer depends on the
# remote sites for them); "no" = the Savant app loads them from their original URLs.
LOCAL_LOGOS="yes"
LOGOS_PORT=14029

# Maximum log size (MB) before rotation.
LOG_MAX_MB=50
